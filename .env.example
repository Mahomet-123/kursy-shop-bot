# ===== Telegram =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# ID чата админа (твой Telegram user id, можно узнать у @userinfobot)
# Только этот чат получает заказы на подтверждение выдачи
ADMIN_CHAT_ID=000000000

# ===== Платежи =====
# manual   -> ручное подтверждение: покупатель переводит по реквизитам и жмёт «Я оплатил» (по умолчанию)
# demo     -> то же, но без реквизитов (для быстрого теста)
# yoomoney -> реальный приём через ЮMoney (СБП/карты), если позже захочешь автоматизацию
PAYMENT_PROVIDER=manual

# Реквизиты для перевода (для manual). Перенос строки — через \n
# Пример: "СБП (телефон): +7 900 000-00-00 (Т-Банк)\nКарта: 2200 0000 0000 0000"
PAYMENT_DETAILS=

# Номер кошелька ЮMoney (только для yoomoney), напр. 41001112223344
YOOMONEY_WALLET=

# Секрет уведомлений ЮMoney (задаётся в настройках кошелька ->
# "Параметры" -> "Уведомления" -> "Секретное слово"). Нужен для проверки платежа.
YOOMONEY_SECRET=

# ===== Деплой / Webhook =====
# На Render заполняется автоматически (переменная RENDER_EXTERNAL_URL).
# Локально или на своём VPS укажи публичный https-адрес, напр. https://bot.example.com
# Если пусто — бот работает в режиме long polling (без вебхука).
PUBLIC_URL=

# Порт (Render задаёт сам)
PORT=3000
